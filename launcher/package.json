{
  "name": "youtube-live-chat-launcher",
  "version": "1.0.0",
  "private": true,
  "description": "Launcher with auto-update for Keybaht Live Chat",
  "main": "index.js",
  "bin": "index.js",
  "scripts": {
    "start": "node index.js",
    "build": "pkg . --targets node18-win-x64 --output ../release/YouTubeLiveChat.exe"
  },
  "pkg": {
    "assets": ["public/**/*"],
    "outputPath": "../release",
    "icon": "../branding/app.ico"
  }
}
